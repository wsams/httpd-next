# Python flavor: Nginx + Uvicorn (ASGI) via s6-overlay.
# docker build -t wsams/httpd-next:python-local -f Dockerfile.python --build-arg BASE_IMAGE=wsams/httpd-next:local .
ARG BASE_IMAGE=wsams/httpd-next:latest
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    NGINX_TEMPLATE=/etc/nginx/templates/python.conf.template \
    PYTHON_APP_MODULE=app:app \
    PYTHON_APP_DIR=/var/www/python \
    PYTHON_HOST=127.0.0.1 \
    PYTHON_PORT=8000 \
    PIP_BREAK_SYSTEM_PACKAGES=1

COPY docker/nginx/templates/python.conf.template /etc/nginx/templates/python.conf.template
COPY docker/s6/python/uvicorn/run /etc/s6-overlay/s6-rc.d/uvicorn/run
COPY docker/s6/python/uvicorn/type /etc/s6-overlay/s6-rc.d/uvicorn/type
COPY examples/python/app.py /var/www/python/app.py
COPY examples/python/requirements.txt /tmp/requirements.txt

RUN apt-get update && \
    apt-get -y install --no-install-recommends \
        python3 \
        python3-pip \
        python3-venv && \
    pip3 install --no-cache-dir -r /tmp/requirements.txt && \
    chmod 755 /etc/s6-overlay/s6-rc.d/uvicorn/run && \
    touch /etc/s6-overlay/s6-rc.d/user/contents.d/uvicorn && \
    rm -f /tmp/requirements.txt && \
    apt-get -y autoremove && \
    apt-get -y clean && \
    rm -rf /var/lib/apt/lists/*
